# =============================================================================
# YouTube AI Comment Responder - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# YouTube Data API v3
# -----------------------------------------------------------------------------
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in your project
YOUTUBE_API_KEY=your_youtube_api_key_here

# OAuth 2.0 credentials for posting replies (required for write operations)
# Download credentials.json from Google Cloud Console
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# Your YouTube channel ID (found in YouTube Studio > Settings > Channel > Advanced)
YOUTUBE_CHANNEL_ID=your_channel_id_here

# -----------------------------------------------------------------------------
# Anthropic Claude API
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model configuration
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Redis (for Celery task queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# ChromaDB (Vector Store)
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=video_transcripts

# Embedding model for RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# PostgreSQL (Comment tracking database)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/youtube_responder
# For SQLite during development:
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# -----------------------------------------------------------------------------
# FastAPI Application
# -----------------------------------------------------------------------------
APP_NAME=YouTube AI Comment Responder
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# Rate Limiting & Quotas
# -----------------------------------------------------------------------------
# YouTube API quota: 10,000 units/day
# Read operations: ~1 unit, Write operations: ~50 units
YOUTUBE_DAILY_QUOTA_LIMIT=10000
YOUTUBE_QUOTA_RESERVE=1000

# Max comments to process per batch
MAX_COMMENTS_PER_BATCH=50

# Delay between API calls (seconds)
YOUTUBE_API_DELAY=1.0

# -----------------------------------------------------------------------------
# Response Generation Settings
# -----------------------------------------------------------------------------
# Tier thresholds for response routing
TIER1_MAX_TOKENS=20
TIER2_RAG_SIMILARITY_THRESHOLD=0.75

# Content moderation
ENABLE_CONTENT_MODERATION=true
MAX_RESPONSE_LENGTH=500

# -----------------------------------------------------------------------------
# Channel Context (AI learns persona from these + video transcripts)
# -----------------------------------------------------------------------------
# The AI dynamically adapts to your channel's style - no hardcoding in code!
# Set these to match YOUR channel, and the AI will respond authentically.
CHANNEL_NAME=YourChannelName
CHANNEL_LANGUAGE=English
CHANNEL_TOPICS=your,channel,topics,here
CHANNEL_TONE=friendly,helpful,professional

# -----------------------------------------------------------------------------
# Celery Worker Settings
# -----------------------------------------------------------------------------
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300

# Comment fetch schedule (cron expression)
COMMENT_FETCH_SCHEDULE=*/30 * * * *

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=9090

# Sentry (optional error tracking)
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret key for JWT token signing (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# API authentication (optional, for protecting endpoints)
API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
# Dry run mode (don't actually post replies)
DRY_RUN=true

# Enable debug endpoints
ENABLE_DEBUG_ENDPOINTS=true